# Copy to .env for local overrides. Never commit a real .env file.

# Port the server listens on (Render sets this automatically).
PORT=3000

# SQLite file location. Reseeded from server/seed/*.json on every boot.
DB_PATH=./data/shoplab.sqlite

# When set, every /api/test/* request must send this value in the X-Test-Key header.
# Leave empty locally. Set it as a secret on the public deployment.
TEST_API_KEY=

# Set to false to silence request logging.
LOG_REQUESTS=true
